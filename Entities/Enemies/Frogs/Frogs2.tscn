[sub_resource type="GDScript" id="GDScript_048ps"]
script/source = "extends CharacterBody2D

@export var speed: float = 200.0
@onready var anim_sprite: AnimatedSprite2D = $AnimatedSprite2D

func _physics_process(delta: float) -> void:
	# Set constant left movement velocity
	velocity = Vector2.LEFT * speed
	
	# Move and slide with collision detection
	move_and_slide()
	
	# Destroy when off-screen (adjust -50 to match your screen needs)
	if position.x < -50:
		queue_free()

func _on_visible_on_screen_notifier_2d_screen_exited() -> void:
	queue_free()

# Function to stop the enemy's animation
func stop_animation() -> void:
	if anim_sprite:
		var current_frame = anim_sprite.frame
		anim_sprite.stop()  # stops the animation (freezes on current frame)
		anim_sprite.frame = current_frame  # ensures it stays on that frame
"

